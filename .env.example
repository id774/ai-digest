# Copy this file to .env and adjust the values.
# Every variable is optional except one Anthropic authentication value,
# which the batch requires when SUMMARIZER_BACKEND is 'claude'.
# Set SUMMARIZER_BACKEND=plain to run the whole pipeline without an API
# key at all. The Flask viewer runs without any of these variables.

# Claude API key used for summarization and classification.
# Required unless SUMMARIZER_BACKEND=plain.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Bearer token for an Anthropic-compatible API. Do not set this together
# with ANTHROPIC_API_KEY.
ANTHROPIC_AUTH_TOKEN=

# Base URL for an Anthropic-compatible API. Leave empty for Anthropic.
ANTHROPIC_BASE_URL=

# Model used for summarization.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Thinking output of the model. 'default' sends no thinking parameter
# and keeps whatever the provider does. 'disabled' sends
# thinking.type=disabled, for a model that would otherwise spend the
# whole output budget thinking before it calls the tool.
ANTHROPIC_THINKING_MODE=default

# How the tool is selected. 'forced' names build_report the way
# Anthropic expects. 'auto' leaves the choice to the model, for an
# endpoint that does not honour a named tool; the system prompt then
# tells the model to call build_report.
ANTHROPIC_TOOL_CHOICE_MODE=forced

# Sakura AI Engine example:
# ANTHROPIC_AUTH_TOKEN=<UUID>:<secret>
# ANTHROPIC_BASE_URL=https://api.ai.sakura.ad.jp
# ANTHROPIC_MODEL=preview/Kimi-K2.6
# ANTHROPIC_THINKING_MODE=disabled
# ANTHROPIC_TOOL_CHOICE_MODE=auto

# 'claude' (default) summarizes, clusters and translates with the
# Claude API. 'plain' skips the API entirely: no key needed, but topics
# are not clustered or translated, one entry becomes one topic.
SUMMARIZER_BACKEND=claude

# arXiv categories to collect, comma separated.
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL

# Maximum arXiv entries fetched per category.
ARXIV_MAX_RESULTS=60

# News feeds to collect, comma separated.
NEWS_FEED_URLS=https://openai.com/news/rss.xml,https://blog.google/technology/ai/rss/,https://huggingface.co/blog/feed.xml

# Age limit of collected entries, in hours.
LOOKBACK_HOURS=24

# Maximum topics per daily report. Six fills the summary image grid.
MAX_TOPICS=6

# CJK capable font used for generated images. Leave empty to let the
# application probe the usual Noto CJK locations.
AI_DIGEST_FONT_PATH=

# Directory holding the generated reports.
DATA_DIR=data/reports

# HTTP timeout in seconds, applied to every outgoing request.
HTTP_TIMEOUT=15

# Port used by the development server.
PORT=5000
