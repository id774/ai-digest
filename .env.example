# Copy this file to .env and adjust the values.
# Every variable is optional except one Anthropic authentication value,
# which the batch requires when SUMMARIZER_BACKEND is 'claude'.
# Set SUMMARIZER_BACKEND=plain to run the whole pipeline without an API
# key at all. The Flask viewer runs without any of these variables.

# Claude API key used for summarization and classification.
# Required unless SUMMARIZER_BACKEND=plain. Left empty on purpose: a
# placeholder here reads as a configured key, so the batch would pass
# its authentication check, collect from every source and only fail on
# the API call at the end of the run.
ANTHROPIC_API_KEY=

# Bearer token for an Anthropic-compatible API. Do not set this together
# with ANTHROPIC_API_KEY.
ANTHROPIC_AUTH_TOKEN=

# Base URL for an Anthropic-compatible API. Leave empty for Anthropic.
ANTHROPIC_BASE_URL=

# Model used for summarization.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Thinking output of the model. 'default' sends no thinking parameter
# and keeps whatever the provider does. 'disabled' sends
# thinking.type=disabled, for a model that would otherwise spend the
# whole output budget thinking before it calls the tool.
ANTHROPIC_THINKING_MODE=default

# How the tool is selected. 'forced' names build_report the way
# Anthropic expects. 'any' demands a tool without naming one, which is
# unambiguous because build_report is the only tool offered, and is
# worth trying on an endpoint that drops a named tool_choice. 'auto'
# leaves the choice to the model; the system prompt then tells the
# model to call build_report.
ANTHROPIC_TOOL_CHOICE_MODE=forced

# Whether a report written as JSON text is accepted when no tool call
# came back. 'disabled' accepts only a real tool call. 'enabled' also
# reads a text block that parses into an object with a topics list.
# Turn it on only after a raw response has shown that the endpoint
# really does answer with the right JSON.
ANTHROPIC_TEXT_JSON_FALLBACK=disabled

# Retries the Anthropic SDK may spend on one request. Set 0 to spend
# exactly one request per run, which is what comparing two endpoint
# settings needs.
ANTHROPIC_MAX_RETRIES=2

# Sakura AI Engine example:
# ANTHROPIC_AUTH_TOKEN=<UUID>:<secret>
# ANTHROPIC_BASE_URL=https://api.ai.sakura.ad.jp
# ANTHROPIC_MODEL=preview/Kimi-K2.6
# ANTHROPIC_THINKING_MODE=disabled
# ANTHROPIC_TOOL_CHOICE_MODE=auto

# OpenAI compatible endpoint, used by SUMMARIZER_BACKEND=openai only.
# The base URL includes the version path, unlike the Anthropic one.
# This backend needs the openai package: pip install openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Sakura AI Engine over the OpenAI compatible API:
# SUMMARIZER_BACKEND=openai
# OPENAI_API_KEY=<UUID>:<secret>
# OPENAI_BASE_URL=https://api.ai.sakura.ad.jp/v1
# OPENAI_MODEL=preview/Kimi-K2.6

# 'claude' (default) summarizes, clusters and translates with the
# Claude API. 'plain' skips the API entirely: no key needed, but topics
# are not clustered or translated, one entry becomes one topic.
# 'openai' calls an OpenAI compatible Chat Completions API instead, for
# a provider whose Anthropic compatible endpoint returns no tool call.
SUMMARIZER_BACKEND=claude

# arXiv categories to collect, comma separated.
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL

# Maximum arXiv entries fetched per category.
ARXIV_MAX_RESULTS=60

# News feeds to collect, comma separated.
NEWS_FEED_URLS=https://openai.com/news/rss.xml,https://blog.google/technology/ai/rss/,https://huggingface.co/blog/feed.xml

# Age limit of collected entries, in hours.
LOOKBACK_HOURS=24

# Maximum topics per daily report. Six fills the summary image grid.
MAX_TOPICS=6

# Tokens the model may produce in one answer, on either API backend.
# The default fits the report with room to spare. A model that thinks
# before answering draws on this same budget, so an endpoint whose
# thinking cannot be turned off may need more; raising it buys no tool
# call on its own.
MAX_OUTPUT_TOKENS=8000

# Seconds allowed for one summarization request, on either API backend.
# Separate from HTTP_TIMEOUT because it measures the writing, not the
# network: nothing is streamed, so the client waits until the last
# token of the answer exists. Each retry spends it again, so the worst
# case wait is SUMMARIZER_TIMEOUT x (ANTHROPIC_MAX_RETRIES + 1).
SUMMARIZER_TIMEOUT=180

# CJK capable font used for generated images. Leave empty to let the
# application probe the usual Noto CJK locations.
AI_DIGEST_FONT_PATH=

# Directory holding the generated reports.
DATA_DIR=data/reports

# HTTP timeout in seconds, applied to every collector and scraper
# request. The summarization request uses SUMMARIZER_TIMEOUT instead.
HTTP_TIMEOUT=60

# User-Agent sent with every outgoing request. It names the project so
# that an operator reading their logs can tell who is calling. Leave
# empty to use the built in default.
USER_AGENT=

# Port used by the development server and by gunicorn.
PORT=3000
