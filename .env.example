# Copy this file to .env and adjust the values.
# Every variable is optional except ANTHROPIC_API_KEY, which the batch
# pipeline requires. The Flask viewer runs without any of them.

# Claude API key used for summarization and classification.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Model used for summarization.
ANTHROPIC_MODEL=claude-sonnet-4-5

# arXiv categories to collect, comma separated.
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL

# Maximum arXiv entries fetched per category.
ARXIV_MAX_RESULTS=60

# News feeds to collect, comma separated.
NEWS_FEED_URLS=https://openai.com/news/rss.xml,https://blog.google/technology/ai/rss/,https://huggingface.co/blog/feed.xml

# Age limit of collected entries, in hours.
LOOKBACK_HOURS=24

# Maximum topics per daily report. Six fills the summary image grid.
MAX_TOPICS=6

# CJK capable font used for generated images. Leave empty to let the
# application probe the usual Noto CJK locations.
AI_DIGEST_FONT_PATH=

# Directory holding the generated reports.
DATA_DIR=data/reports

# HTTP timeout in seconds, applied to every outgoing request.
HTTP_TIMEOUT=15

# Port used by the development server.
PORT=5000
