# Copy this file to .env and adjust the values.
# Every variable is optional except one credential, which the batch
# requires when SUMMARIZER_BACKEND names an API backend. Set
# SUMMARIZER_BACKEND=plain to run the whole pipeline without a
# credential at all. The Flask viewer runs without any of these
# variables.
#
# The settings that address the endpoint are named after the stage that
# spends them and not after a vendor: 'anthropic-compatible' is a wire
# protocol spoken by endpoints belonging to neither Anthropic nor
# OpenAI, and one key, base URL and model reach whichever is configured.
# The former ANTHROPIC_* and OPENAI_* names are refused at startup, so
# that a value exported for another tool cannot decide where a digest
# is sent; the batch names the replacement when it finds one.

# Wire protocol of the summarization endpoint.
#   anthropic-compatible  Anthropic Messages API (default)
#   openai-compatible     OpenAI Chat Completions API, for a provider
#                         whose Anthropic compatible endpoint returns
#                         no usable tool call
#   plain                 no API at all: entries are not clustered or
#                         translated, one entry becomes one topic
SUMMARIZER_BACKEND=anthropic-compatible

# API key of the endpoint. Required unless SUMMARIZER_AUTH_TOKEN is set
# instead, or SUMMARIZER_BACKEND=plain. Left empty on purpose: a
# placeholder here reads as a configured key, so the batch would pass
# its authentication check, collect from every source and only fail on
# the API call at the end of the run.
SUMMARIZER_API_KEY=

# Bearer token of the endpoint. Do not set this together with
# SUMMARIZER_API_KEY. On the anthropic-compatible backend the two
# choose between the x-api-key and Authorization headers; on the
# openai-compatible one both become the Bearer header the SDK sends
# either way.
SUMMARIZER_AUTH_TOKEN=

# Base URL of the endpoint. Leave empty for Anthropic itself. The
# openai-compatible backend expects the version path to be part of it,
# unlike the anthropic-compatible one.
SUMMARIZER_BASE_URL=

# Model used for summarization. Leave empty to ask for the default
# Claude model on the anthropic-compatible backend; the
# openai-compatible backend has no default and requires a name, because
# the models an endpoint offers are its own.
SUMMARIZER_MODEL=claude-sonnet-4-5

# Retries the SDK may spend on one request, on either API backend. Set
# 0 to spend exactly one request per run, which is what comparing two
# endpoint settings needs.
SUMMARIZER_MAX_RETRIES=2

# Thinking output of the model, read by the anthropic-compatible
# backend. 'default' sends no thinking parameter and keeps whatever the
# provider does. 'disabled' sends thinking.type=disabled, for a model
# that would otherwise spend the whole output budget thinking before it
# calls the tool.
SUMMARIZER_THINKING_MODE=default

# How the tool is selected, read by the anthropic-compatible backend.
# 'forced' names build_report the way Anthropic expects. 'any' demands
# a tool without naming one, which is unambiguous because build_report
# is the only tool offered, and is worth trying on an endpoint that
# drops a named tool_choice. 'auto' leaves the choice to the model; the
# system prompt then tells the model to call build_report.
SUMMARIZER_TOOL_CHOICE_MODE=forced

# Whether a report written as JSON text is accepted when no tool call
# came back, read by the anthropic-compatible backend. 'disabled'
# accepts only a real tool call. 'enabled' also reads a text block that
# parses into an object with a topics list. Turn it on only after a raw
# response has shown that the endpoint really does answer with the
# right JSON.
SUMMARIZER_TEXT_JSON_FALLBACK=disabled

# Sakura AI Engine over the Anthropic compatible API:
# SUMMARIZER_BACKEND=anthropic-compatible
# SUMMARIZER_AUTH_TOKEN=<UUID>:<secret>
# SUMMARIZER_BASE_URL=https://api.ai.sakura.ad.jp
# SUMMARIZER_MODEL=preview/Kimi-K2.6
# SUMMARIZER_THINKING_MODE=disabled
# SUMMARIZER_TOOL_CHOICE_MODE=auto

# Sakura AI Engine over the OpenAI compatible API. The base URL carries
# the version path here, which the Anthropic compatible one does not.
# This backend needs the openai package: pip install openai
# SUMMARIZER_BACKEND=openai-compatible
# SUMMARIZER_API_KEY=<UUID>:<secret>
# SUMMARIZER_BASE_URL=https://api.ai.sakura.ad.jp/v1
# SUMMARIZER_MODEL=preview/Kimi-K2.6

# arXiv categories to collect, comma separated.
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL

# Maximum arXiv entries fetched per category.
ARXIV_MAX_RESULTS=60

# News feeds to collect, comma separated.
NEWS_FEED_URLS=https://openai.com/news/rss.xml,https://blog.google/technology/ai/rss/,https://huggingface.co/blog/feed.xml

# Age limit of collected entries, in hours.
LOOKBACK_HOURS=24

# Maximum topics per daily report. Six fills the summary image grid.
MAX_TOPICS=6

# Tokens the model may produce in one answer, on either API backend.
# The default fits the report with room to spare. A model that thinks
# before answering draws on this same budget, so an endpoint whose
# thinking cannot be turned off may need more; raising it buys no tool
# call on its own.
MAX_OUTPUT_TOKENS=8000

# Seconds allowed for one summarization request, on either API backend.
# Separate from HTTP_TIMEOUT because it measures the writing, not the
# network: nothing is streamed, so the client waits until the last
# token of the answer exists. Each retry spends it again, so the worst
# case wait is SUMMARIZER_TIMEOUT x (SUMMARIZER_MAX_RETRIES + 1).
SUMMARIZER_TIMEOUT=180

# CJK capable font used for generated images. Leave empty to let the
# application probe the usual Noto CJK locations.
AI_DIGEST_FONT_PATH=

# Directory holding the generated reports.
DATA_DIR=data/reports

# HTTP timeout in seconds, applied to every collector and scraper
# request. The summarization request uses SUMMARIZER_TIMEOUT instead.
HTTP_TIMEOUT=60

# User-Agent sent with every outgoing request. It names the project so
# that an operator reading their logs can tell who is calling. Leave
# empty to use the built in default.
USER_AGENT=

# Port used by the development server and by gunicorn.
PORT=3000

# The legacy ANTHROPIC_* and OPENAI_* settings are not read. A process
# finding one of them in its environment stops at startup and names its
# replacement, so that a stale export cannot decide where a digest is
# sent.
