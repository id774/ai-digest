# Example crontab for the daily batch. Install it as the service user:
#
#     sudo -u ai-digest crontab deploy/ai-digest.cron
#
# The batch reads its settings from .env, which cron does not load, so
# the command runs from the installation directory where python-dotenv
# finds it.

SHELL=/bin/sh
# Redirect both stdout and stderr to the log file below. Cron therefore
# has nothing left to mail regardless of MAILTO or exit status. Check
# the log file to see whether a run failed.
MAILTO=root

# 06:30 local time. arXiv announces on weekdays only, so a Saturday or
# Sunday run typically sees no papers. It still exits 0 if a configured
# news feed offers something recent. Exit 1 is not limited to a run that
# collected nothing. A configuration, credential, model response,
# rendering, or publication failure also produces exit 1. Read the log
# to distinguish these cases.
30 6 * * * cd /opt/ai-digest && .venv/bin/python cli.py run >> /var/log/ai-digest/run.log 2>&1
