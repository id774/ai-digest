# Example systemd unit for the read only viewer. Copy it to
# /etc/systemd/system/ and adjust the user, the paths and the port
# before enabling it. The batch is not started from here: it runs from
# cron, see ai-digest.cron.

[Unit]
Description=ai-digest web viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-digest
Group=ai-digest
WorkingDirectory=/opt/ai-digest
# The viewer resolves only DATA_DIR and PORT (see config.py's
# load_viewer_config()), so it takes them here rather than from the
# batch's .env, which a service running as this unit's user need not
# even be able to read.
Environment=DATA_DIR=/opt/ai-digest/data/reports
Environment=PORT=3000
ExecStart=/opt/ai-digest/.venv/bin/gunicorn app:app \
          --bind 127.0.0.1:${PORT} --workers 2 --timeout 60
# The viewer only reads what the batch already wrote, so a crash is
# never a half finished report and restarting is always safe.
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# ProtectSystem=full leaves /opt writable, which DATA_DIR needs when
# the archive lives under the installation directory.
ProtectSystem=full

[Install]
WantedBy=multi-user.target
